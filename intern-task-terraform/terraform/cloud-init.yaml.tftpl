#cloud-config
package_update: true
packages:
  - docker.io
  - ufw

users:
  - name: ${admin_user}
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  # the real intern-task-app source, embedded from the other task's folder
  - path: /opt/intern-task-app/Dockerfile
    encoding: b64
    content: ${dockerfile_b64}
  - path: /opt/intern-task-app/app/app.py
    encoding: b64
    content: ${app_py_b64}
  - path: /etc/systemd/system/intern-task-app.service
    content: |
      [Unit]
      Description=intern-task-app container
      After=docker.service network-online.target
      Requires=docker.service
      Wants=network-online.target

      [Service]
      Restart=always
      ExecStartPre=-/usr/bin/docker rm -f intern-task-app
      # host network so the host firewall (ufw) actually governs the port;
      # ports published with -p go through docker's own iptables rules and
      # bypass ufw entirely
      ExecStart=/usr/bin/docker run --rm --name intern-task-app --network host intern-task-app:local
      ExecStop=/usr/bin/docker stop intern-task-app

      [Install]
      WantedBy=multi-user.target

runcmd:
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow ${app_port}/tcp
  - ufw allow from ${ssh_cidr} to any port 22 proto tcp
  - ufw --force enable
  - systemctl enable --now docker
  - docker build -t intern-task-app:local /opt/intern-task-app
  - systemctl daemon-reload
  - systemctl enable --now intern-task-app
